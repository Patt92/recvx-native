# Private disc data, old history and obsolete builds
/archived/
/data/
/build/

# Local tools and OS/editor caches
/build-tools/ffmpeg.exe
/build-tools/ffprobe.exe
/build-tools/*.dll
__pycache__/
*.py[cod]
.DS_Store
.venv/
venv/
.wineprefix/
.idea/
.vscode/

# Proprietary SDKs and generated decompilation artifacts
/include/recvx-decomp-*/
/context/
*.iso
*.ISO
# Disc images of any format stay local; only the placeholder is versioned.
/iso/*
!/iso/.gitkeep
*.afs
*.AFS
dwarfdump.txt
objdiff.exe
objdiff.json

# Local HD/texture mods (large)
/mods/

# Local save files and snapshots
/saves/
/snapshots/
