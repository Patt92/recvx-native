# Private disc data, old history and obsolete builds
/archived/
/data/
/build/

# Local agent instructions
/CLAUDE.md
/AGENTS.md

# Local tools and OS/editor caches
/build-tools/ffmpeg.exe
/build-tools/ffprobe.exe
/build-tools/*.dll
__pycache__/
*.py[cod]
.DS_Store
.venv/
venv/
.wineprefix/
.idea/
.vscode/

# Proprietary SDKs and generated decompilation artifacts
/include/recvx-decomp-*/
/context/
*.iso
*.ISO
# Disc images of any format stay local; only the placeholder is versioned.
/iso/*
!/iso/.gitkeep
*.afs
*.AFS
dwarfdump.txt
objdiff.exe
objdiff.json

# Local HD/texture mods (large)
/mods/

# Local save files and snapshots
/saves/

# Docker builder output (compose.yaml)
/out/
/snapshots/
/data_compressed/

# AMD FidelityFX SDK: optional external build input, binaries never committed
/native/third_party/FidelityFX-SDK/**/*.dll
/native/third_party/FidelityFX-SDK/**/*.lib
/native/third_party/FidelityFX-SDK/**/*.so
/native/third_party/FidelityFX-SDK/**/.DS_Store

# Local secrets (agent-play LLM endpoint keys)
.env

# Web-Pruefung (tests/web): npm-Abhaengigkeiten lokal
node_modules/
